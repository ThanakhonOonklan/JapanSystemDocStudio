#!/bin/bash

# Documentation Studio REA: cap the V8 heap so one service cannot balloon.
NODE_PARAMS="--max-old-space-size=128"
if [ "$DEBUG_NODE" == "true" ]; then
    echo "running debug - docstore"
    NODE_PARAMS="$NODE_PARAMS --inspect=0.0.0.0:30160"
fi

source /etc/overleaf/env.sh
export LISTEN_ADDRESS=127.0.0.1

exec /sbin/setuser www-data /usr/bin/node $NODE_PARAMS /overleaf/services/docstore/app.js >> /var/log/overleaf/docstore.log 2>&1
